# Copy to .env (never commit .env):  cp .env.example .env
# All values are optional.

# ---- Network ----
# Host interface and port for the published container port. Keep 127.0.0.1 and use an HTTPS reverse proxy.
VAULT_BIND=127.0.0.1
VAULT_PORT=8080
# Set to 1 (number of proxy hops) when running behind a reverse proxy, so client IPs and HTTPS are detected.
TRUST_PROXY=false
# auto = Secure cookie when the request came over HTTPS; set true behind an HTTPS proxy.
COOKIE_SECURE=auto
SESSION_TTL_HOURS=12
LOG_LEVEL=info

# ---- Initial administrator (FIRST start only) ----
# If empty, values are generated and saved to /data/config/initial-credentials.txt inside the vault-config volume.
# Changing them after the first start has no effect.
VAULT_ADMIN_EMAIL=
# At least 12 characters.
VAULT_ADMIN_PASSWORD=
# At least 32 characters, no whitespace. Generate with:  openssl rand -base64 32 | tr -d '=+/' | sed 's/^/vlt_/'
VAULT_ACCESS_TOKEN=
